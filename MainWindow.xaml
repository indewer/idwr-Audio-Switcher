<Window x:Class="AudioSwitcherWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioSwitcherWidget"
        mc:Ignorable="d"
        Title="(idwr) Audio Switcher" 
        Width="350" 
        SizeToContent="Height"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="#4A4E69" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IconButton Style -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2D3247"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3B4261"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- LinkButton Style -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with Glow and Rounded Corners -->
    <Border Margin="14" CornerRadius="18" BorderThickness="1.2" BorderBrush="#353A52">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C1D26" Offset="0.0"/>
                <GradientStop Color="#14141B" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Body / Device list or Settings -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="#26283B" Margin="0,0,10,0">
                        <!-- Sound Wave Icon -->
                        <Path Fill="#818CF8" Data="M12 3v18M8 8v8M4 11v2M16 6v12M20 9v6" 
                              Stroke="#818CF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="14" Height="14"/>
                    </Border>
                    <TextBlock Text="(idwr) Audio Switcher" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Header Controls (Pin, Settings, Minimize, Close) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin (Always on top) button -->
                    <Button Style="{StaticResource HeaderIconButton}" Click="PinButton_Click" ToolTip="Закрепить поверх всех окон" Margin="0,0,2,0">
                        <Path Data="M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z" 
                              Fill="{Binding AlwaysOnTop, Converter={x:Null}}" 
                              Stretch="Uniform" Width="12" Height="12">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#9CA3AF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                            <Setter Property="Fill" Value="#818CF8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource HeaderIconButton}" Click="SettingsButton_Click" ToolTip="Настройка устройств" Margin="0,0,2,0">
                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                              Fill="#9CA3AF" Stretch="Uniform" Width="13" Height="13"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource HeaderIconButton}" Click="MinimizeButton_Click" ToolTip="Свернуть в трей" Margin="0,0,2,0">
                        <Rectangle Width="10" Height="1.8" Fill="#9CA3AF"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource HeaderIconButton}" Click="CloseButton_Click" ToolTip="Закрыть">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                              Fill="#9CA3AF" Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- BODY: VIEW 1 - SWITCHER (VisibleDevices) -->
            <Grid Grid.Row="1" Visibility="{Binding IsWidgetViewVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding VisibleDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Button -->
                            <Button Margin="0,0,0,8" Cursor="Hand" Click="DeviceCard_Click" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" CornerRadius="12" BorderThickness="1.2" Padding="12,10" Background="#202230" BorderBrush="#2D3247">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Device Icon Box -->
                                                <Border x:Name="iconBox" Width="36" Height="36" CornerRadius="9" Background="#282B3D" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Path x:Name="iconPath" Data="{Binding IconGeometry}" 
                                                          Stroke="#9CA3AF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Fill="Transparent" Stretch="Uniform" Width="18" Height="18" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Titles -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Status / Active Pill -->
                                                <Border x:Name="statusPill" Grid.Column="2" Visibility="Collapsed" Background="#312E81" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Активно" Foreground="#E0E7FF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Mouse Over State -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#282C3F"/>
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#434966"/>
                                            </Trigger>

                                            <!-- Active Default Device State -->
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#25244A"/>
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#6366F1"/>
                                                <Setter TargetName="iconBox" Property="Background" Value="#3730A3"/>
                                                <Setter TargetName="iconPath" Property="Stroke" Value="#C7D2FE"/>
                                                <Setter TargetName="statusPill" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- BODY: VIEW 2 - SETTINGS (AllDevicesSettings + options) -->
            <Grid Grid.Row="1" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Настройка списка устройств" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4"/>
                    <TextBlock Text="Оставьте галочки только у нужных выходов:" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,10"/>

                    <!-- Scrollable list of all detected devices -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding AllDevicesSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F212E" CornerRadius="8" Margin="0,0,0,6" Padding="10,8" BorderThickness="1" BorderBrush="#2A2E42">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Checkbox to show/hide -->
                                            <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding OriginalFullName}" FontWeight="Medium" Foreground="#E2E8F0"/>

                                            <!-- Custom rename textbox -->
                                            <Grid Grid.Row="1" Margin="24,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Имя:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#161722" Foreground="#F1F5F9" BorderBrush="#353A52" 
                                                         Padding="6,3" FontSize="11.5" BorderThickness="1"
                                                         ToolTip="Краткое понятное название (например: Наушники, Колонки, ТВ)"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Global options -->
                    <Border Background="#1C1E2B" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#2A2E42">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding SortByRecent}" Content="Недавние устройства всегда сверху" Margin="0,0,0,6" ToolTip="Активные и последние используемые аудиовыходы поднимаются в начало списка"/>
                            <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="Закрепить поверх всех окон" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Запускать при старте Windows"/>
                        </StackPanel>
                    </Border>

                    <!-- About / Info Section -->
                    <Border Background="#151620" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#252839">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="(idwr) Audio Switcher" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="11.5"/>
                                <Border Grid.Column="1" Background="#312E81" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="0.1 b5" Foreground="#A5B4FC" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Button Style="{StaticResource LinkButton}" Click="OpenTelegram_Click" ToolTip="Открыть в Telegram">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Telegram: " Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="@indewer" Foreground="#818CF8" FontWeight="Medium" FontSize="11" TextDecorations="Underline"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Click="OpenEmail_Click" ToolTip="Написать на почту" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Email: " Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="indewer@ya.ru" Foreground="#818CF8" FontWeight="Medium" FontSize="11" TextDecorations="Underline"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Save & Back Button -->
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить и применить" Click="SaveSettingsButton_Click"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
